[Unit]
Description=CPU turbo boost sync with power-profiles-daemon
Requires=power-profiles-daemon.service
After=graphical.target

[Service]
Type=simple
Environment=PPD_BOOST_DEBUG=0
ExecStart=/usr/bin/python3 -u /usr/bin/ppd-cpu-boost
StandardOutput=journal
StandardError=journal
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical.target