#!/usr/bin/python3

import asyncio
import logging
import os
import signal
import sys
from typing import ClassVar

from dbus_fast import BusType, DBusError, Message, MessageType
from dbus_fast.aio import MessageBus

LOG_LEVEL = logging.DEBUG if os.environ.get("PPD_BOOST_DEBUG") == "1" else logging.INFO
logging.basicConfig(
    level=LOG_LEVEL,
    format="[%(levelname)s] %(message)s",
)
logger = logging.getLogger("ppd-cpu-boost")


class PPDBoostSync:
    DBUS_CANDIDATES = (
        "org.freedesktop.UPower.PowerProfiles",
        "net.hadess.PowerProfiles",
    )
    BOOST_PATH = "/sys/devices/system/cpu/cpufreq/boost"
    DBUS_SERVICE = "org.freedesktop.DBus"
    DBUS_PATH = "/org/freedesktop/DBus"
    DBUS_INTERFACE = "org.freedesktop.DBus"
    PROFILE_POLICY: ClassVar[dict[str, bool]] = {
        "performance": True,
        "balanced": False,
        "power-saver": False,
    }

    def __init__(self) -> None:
        self._check_root()
        self._check_amd_cpu()
        self._check_boost_control()

        self.bus: MessageBus | None = None
        self.dbus_name: str = ""
        self.object_path: str = ""

    @staticmethod
    def _check_root() -> None:
        if os.geteuid() != 0:
            raise RuntimeError("Must run as root to change CPU boost through sysfs")

    @staticmethod
    def _check_amd_cpu() -> None:
        try:
            with open("/proc/cpuinfo", encoding="ascii") as cpuinfo:
                is_amd = any(
                    line.startswith("vendor_id")
                    and line.split(":", 1)[1].strip() == "AuthenticAMD"
                    for line in cpuinfo
                )
        except OSError as exc:
            raise RuntimeError(f"Cannot identify CPU vendor: {exc}") from exc

        if not is_amd:
            raise RuntimeError("This AMD-only build does not support non-AMD CPUs")

    def _check_boost_control(self) -> None:
        if not os.path.isfile(self.BOOST_PATH):
            status_path = "/sys/devices/system/cpu/amd_pstate/status"
            amd_pstate_status = "unavailable"
            try:
                with open(status_path, encoding="ascii") as status_file:
                    amd_pstate_status = status_file.read().strip()
            except OSError:
                pass
            raise RuntimeError(
                f"AMD CPU boost control is unavailable at {self.BOOST_PATH} "
                f"(amd_pstate status: {amd_pstate_status})"
            )

        try:
            with open(self.BOOST_PATH, encoding="ascii") as boost_file:
                current = boost_file.read().strip()
        except OSError as exc:
            raise RuntimeError(f"Cannot read {self.BOOST_PATH}: {exc}") from exc

        if current not in {"0", "1"}:
            raise RuntimeError(f"Unexpected value in {self.BOOST_PATH}: {current!r}")

        logger.debug("AMD boost control found; current value: %s", current)

    async def _get_active_profile(self, destination: str) -> str:
        assert self.bus is not None
        object_path = f"/{destination.replace('.', '/')}"
        reply = await self.bus.call(
            Message(
                destination=destination,
                path=object_path,
                interface="org.freedesktop.DBus.Properties",
                member="Get",
                signature="ss",
                body=[destination, "ActiveProfile"],
            )
        )
        if reply is None:
            raise RuntimeError(f"No D-Bus reply from {destination}")
        if reply.message_type == MessageType.ERROR:
            raise DBusError(
                reply.error_name or "org.freedesktop.DBus.Error.Failed", reply.body
            )

        variant = reply.body[0]
        profile = variant.value if hasattr(variant, "value") else variant
        if not isinstance(profile, str):
            raise TypeError(f"Unexpected ActiveProfile type: {type(profile).__name__}")
        return profile

    async def _detect_dbus_namespace(self) -> tuple[str, str]:
        for candidate in self.DBUS_CANDIDATES:
            try:
                await self._get_active_profile(candidate)
                object_path = f"/{candidate.replace('.', '/')}"
                logger.debug(
                    "Connected to power-profiles-daemon D-Bus name %s", candidate
                )
                return candidate, object_path
            except (DBusError, OSError, TypeError, IndexError):
                continue

        raise RuntimeError(
            "Cannot read ActiveProfile from power-profiles-daemon on the system bus"
        )

    async def _add_match_rule(self, rule: str) -> None:
        assert self.bus is not None
        reply = await self.bus.call(
            Message(
                destination=self.DBUS_SERVICE,
                path=self.DBUS_PATH,
                interface=self.DBUS_INTERFACE,
                member="AddMatch",
                signature="s",
                body=[rule],
            )
        )
        if reply is not None and reply.message_type == MessageType.ERROR:
            raise DBusError(
                reply.error_name or "org.freedesktop.DBus.Error.Failed", reply.body
            )

    async def _subscribe_to_events(self) -> None:
        assert self.bus is not None

        await self._add_match_rule(
            f"type='signal',sender='{self.dbus_name}',path='{self.object_path}',"
            "interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'"
        )
        await self._add_match_rule(
            f"type='signal',sender='{self.DBUS_SERVICE}',path='{self.DBUS_PATH}',"
            f"interface='{self.DBUS_INTERFACE}',member='NameOwnerChanged',arg0='{self.dbus_name}'"
        )

        self.bus.add_message_handler(self._on_message)

    def _set_boost(self, enabled: bool, profile: str) -> None:
        target = "1" if enabled else "0"
        try:
            with open(self.BOOST_PATH, encoding="ascii") as boost_file:
                current = boost_file.read().strip()

            if current == target:
                logger.debug(
                    "Boost already %s for profile '%s'; no write needed",
                    target,
                    profile,
                )
                return

            with open(self.BOOST_PATH, "w", encoding="ascii") as boost_file:
                boost_file.write(target)

            logger.info(
                "CPU boost %s (profile: %s)",
                "enabled" if enabled else "disabled",
                profile,
            )
        except OSError as exc:
            logger.error("Failed to update CPU boost at %s: %s", self.BOOST_PATH, exc)

    async def sync_current_state(self, reason: str) -> None:
        try:
            profile = await self._get_active_profile(self.dbus_name)
        except (DBusError, OSError, TypeError, IndexError) as exc:
            logger.warning("Cannot read PPD profile during %s: %s", reason, exc)
            return

        enabled = self.PROFILE_POLICY.get(profile)
        if enabled is None:
            logger.warning(
                "Unknown PPD profile %r; disabling CPU boost as a safe default", profile
            )
            enabled = False

        logger.debug("Synchronizing after %s: profile=%s", reason, profile)
        self._set_boost(enabled, profile)

    def _on_message(self, msg: Message) -> bool:
        if msg.message_type != MessageType.SIGNAL:
            return False

        if (
            msg.interface == "org.freedesktop.DBus.Properties"
            and msg.member == "PropertiesChanged"
            and msg.path == self.object_path
        ):
            self._handle_properties_changed(msg.body)
            return False

        if (
            msg.interface == self.DBUS_INTERFACE
            and msg.member == "NameOwnerChanged"
            and msg.path == self.DBUS_PATH
        ):
            self._handle_name_owner_changed(msg.body)
            return False

        return False

    def _handle_properties_changed(self, body: list) -> None:
        try:
            changed_interface, changed_properties, invalidated = body
            if changed_interface != self.dbus_name:
                return

            if "ActiveProfile" in changed_properties or "ActiveProfile" in invalidated:
                asyncio.create_task(self.sync_current_state("profile change"))
        except (TypeError, ValueError) as exc:
            logger.warning("Could not process PPD PropertiesChanged signal: %s", exc)

    def _handle_name_owner_changed(self, body: list) -> None:
        try:
            name, _old_owner, new_owner = body
            if name != self.dbus_name:
                return

            if new_owner:
                logger.info(
                    "power-profiles-daemon appeared on D-Bus; synchronizing state"
                )
                asyncio.create_task(
                    self.sync_current_state("PPD D-Bus appearance/restart")
                )
            else:
                logger.warning("power-profiles-daemon disappeared from D-Bus")
        except (TypeError, ValueError) as exc:
            logger.warning("Could not process NameOwnerChanged signal: %s", exc)

    async def run(self) -> None:
        self.bus = await MessageBus(bus_type=BusType.SYSTEM).connect()
        try:
            self.dbus_name, self.object_path = await self._detect_dbus_namespace()
            await self._subscribe_to_events()
            await self.sync_current_state("startup")
            logger.debug("Monitoring PPD profile changes and system resume events")

            stop_event = asyncio.Event()
            loop = asyncio.get_running_loop()
            for sig in (signal.SIGINT, signal.SIGTERM):
                loop.add_signal_handler(sig, stop_event.set)

            await stop_event.wait()
        finally:
            if self.bus is not None:
                self.bus.disconnect()


def main() -> int:
    try:
        asyncio.run(PPDBoostSync().run())
    except (RuntimeError, DBusError, OSError) as exc:
        logger.critical("%s", exc)
        return 1
    except KeyboardInterrupt:
        logger.info("Shutting down")
    return 0


if __name__ == "__main__":
    sys.exit(main())
