post_install() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable --now ppd-cpu-boost.service >/dev/null 2>&1 || true
}

post_upgrade() {
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl try-restart ppd-cpu-boost.service >/dev/null 2>&1 || true
}

pre_remove() {
    systemctl disable --now ppd-cpu-boost.service >/dev/null 2>&1 || true
}