#!/usr/bin/env python3

import sys
import os
import logging
from gi.repository import GLib, Gio

_log_level = logging.DEBUG if os.environ.get("PPD_BOOST_DEBUG") == "1" else logging.INFO
logging.basicConfig(
    level=_log_level,
    format="%(levelname)s: %(message)s"
)


class PPDBoostSync:
    DBUS_CANDIDATES = [
        "org.freedesktop.UPower.PowerProfiles",
        "net.hadess.PowerProfiles"
    ]

    def __init__(self):
        self.boost_file = None
        self.enabled_value = None
        self.disabled_value = None
        self.dbus_name = None
        self.object_path = None

        self._check_root()
        self._detect_cpu_paths()
        self._check_amd_pstate_active()
        self.bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
        self._detect_dbus_namespace()

    @staticmethod
    def _check_root():
        """Ensure the script is running with elevated privileges."""
        if os.geteuid() != 0:
            logging.critical("This script must be run as root to write to sysfs.")
            sys.exit(1)

    def _detect_cpu_paths(self):
        """Detect CPU architecture and set appropriate sysfs paths."""
        intel_path = "/sys/devices/system/cpu/intel_pstate/no_turbo"
        if os.path.exists(intel_path):
            self.boost_file = intel_path
            self.enabled_value = "0"
            self.disabled_value = "1"
            logging.debug("Detected Intel (intel_pstate) path: %s", self.boost_file)
            return

        amd_path = "/sys/devices/system/cpu/cpufreq/boost"
        if os.path.exists(amd_path):
            self.boost_file = amd_path
            self.enabled_value = "1"
            self.disabled_value = "0"
            logging.debug("Detected AMD/Generic (cpufreq) path: %s", self.boost_file)
            return

        logging.critical("Could not find supported CPU Boost/Turbo control file.")
        sys.exit(1)

    @staticmethod
    def _check_amd_pstate_active():
        """Skip execution if amd_pstate is in 'active' (EPP) mode.
        In this mode, power-profiles-daemon handles core boost natively,
        and external sysfs boost writes will corrupt its state.
        """
        status_path = "/sys/devices/system/cpu/amd_pstate/status"
        if os.path.exists(status_path):
            try:
                with open(status_path, "r") as f:
                    status = f.read().strip()
                if status == "active":
                    logging.info(
                        "amd_pstate is in 'active' (EPP) mode: power-profiles-daemon "
                        "already manages CPU performance natively. Nothing to do, exiting."
                    )
                    sys.exit(0)
            except IOError as e:
                logging.warning("Could not read amd_pstate status: %s", e)

    def _get_active_profile(self, dbus_name):
        """Fetch the current ActiveProfile value over DBus for a given namespace."""
        result = self.bus.call_sync(
            dbus_name,
            f"/{dbus_name.replace('.', '/')}",
            "org.freedesktop.DBus.Properties",
            "Get",
            GLib.Variant("(ss)", (dbus_name, "ActiveProfile")),
            GLib.VariantType("(v)"),
            Gio.DBusCallFlags.NONE,
            1000,
            None
        )
        return result.get_child_value(0).get_variant().get_string()

    def _detect_dbus_namespace(self):
        """Find the active DBus namespace for power-profiles-daemon."""
        for candidate in self.DBUS_CANDIDATES:
            try:
                self._get_active_profile(candidate)
                self.dbus_name = candidate
                self.object_path = f"/{candidate.replace('.', '/')}"
                logging.debug("Connected to DBus namespace: %s", self.dbus_name)
                return
            except Exception:
                continue

        logging.critical("Could not connect to power-profiles-daemon DBus. Is it running?")
        sys.exit(1)

    def set_boost(self, enable):
        """Write the appropriate value to the sysfs control file."""
        target_val = self.enabled_value if enable else self.disabled_value

        try:
            with open(self.boost_file, "r") as f:
                current_val = f.read().strip()

            if current_val != target_val:
                with open(self.boost_file, "w") as f:
                    f.write(target_val)
                try:
                    active_profile = self._get_active_profile(self.dbus_name)
                except Exception:
                    active_profile = "performance" if enable else "balanced/power-saver"
                logging.info(
                    "Set boost to %s (Target mode: %s)",
                    target_val, active_profile
                )
            else:
                logging.debug("Boost is already set to %s, skipping write.", target_val)

        except IOError as e:
            logging.error("Failed writing to %s: %s", self.boost_file, e)
        except Exception as e:
            logging.error("Unexpected error in set_boost: %s", e)

    def sync_current_state(self, context=""):
        """Read the current active profile from DBus and apply the boost state."""
        try:
            current_profile = self._get_active_profile(self.dbus_name)
            logging.debug("%sCurrent profile is '%s'", f"{context}: " if context else "", current_profile)
            self.set_boost(current_profile == "performance")
        except Exception as e:
            logging.warning("Could not read current profile: %s", e)

    def on_signal(self, connection, sender_name, object_path, interface_name, signal_name, parameters, user_data):
        """Callback for DBus PropertiesChanged signal."""
        try:
            if signal_name == "PropertiesChanged":
                changed_props = parameters.get_child_value(1).unpack()

                if "ActiveProfile" in changed_props:
                    new_profile = changed_props["ActiveProfile"]
                    logging.debug("Detected profile change to '%s'", new_profile)
                    self.set_boost(new_profile == "performance")
                else:
                    logging.debug("PropertiesChanged received without ActiveProfile, ignoring.")
        except Exception as e:
            logging.error("Error processing signal: %s", e)

    def on_name_appeared(self, connection, name, name_owner):
        """Callback for when power-profiles-daemon (re)appears on the bus."""
        logging.debug("power-profiles-daemon (re)appeared on the bus, re-syncing state.")
        self.sync_current_state(context="RESYNC")

    def on_name_vanished(self, connection, name):
        """Callback for when power-profiles-daemon disappears from the bus."""
        logging.warning("power-profiles-daemon disappeared from the bus.")

    def run(self):
        """Subscribe to events, sync initial state, and start the event loop."""
        self.bus.signal_subscribe(
            self.dbus_name,
            "org.freedesktop.DBus.Properties",
            "PropertiesChanged",
            self.object_path,
            None,
            Gio.DBusSignalFlags.NONE,
            self.on_signal,
            None
        )

        Gio.bus_watch_name_on_connection(
            self.bus,
            self.dbus_name,
            Gio.BusNameWatcherFlags.NONE,
            self.on_name_appeared,
            self.on_name_vanished
        )

        self.sync_current_state(context="STARTUP")

        logging.debug("Listening for power profile changes...")

        loop = GLib.MainLoop()
        try:
            loop.run()
        except KeyboardInterrupt:
            logging.debug("Shutting down gracefully...")


if __name__ == "__main__":
    app = PPDBoostSync()
    app.run()
